rules_version = '2';

// ⚠️ Même avertissement que firestore.rules : projet de test partagé, ne pas déployer seules.
//
// Attention : quand plusieurs blocs `match` visent le même fichier, Storage accorde l'accès dès que l'UN d'eux
// l'autorise. Il n'y a donc PAS de règle générale sur `cabinets/{id}/**` : elle annulerait les restrictions du logo
// et des devis. Chaque dossier de fichiers a sa règle, et tout le reste est refusé.
service firebase.storage {
  match /b/{bucket}/o {
    // Membre d'un cabinet actif, depuis l'appareil de sa session en cours.
    function inActiveCabinet(cabinetId) {
      return request.auth != null
        && request.auth.token.ci_cabinet_id == cabinetId
        && firestore.get(/databases/(default)/documents/cabinets/$(cabinetId)).data.active == true
        && firestore.get(/databases/(default)/documents/cabinets/$(cabinetId)/members/$(request.auth.uid)).data.session.authTime
          == request.auth.token.auth_time;
    }

    // Logo du cabinet : lisible par ses membres, modifiable par ses admins (image ≤ 2 Mo).
    match /cabinets/{cabinetId}/logo/{fileName} {
      allow read: if inActiveCabinet(cabinetId);
      allow write: if inActiveCabinet(cabinetId)
        && request.auth.token.ci_role == 'admin'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Devis joint à une offre saisie à la main (E9-5) : PDF, JPG ou PNG de 10 Mo maximum, nom de fichier simple.
    // Un devis envoyé n'est ni remplacé ni supprimé : une nouvelle saisie envoie un nouveau fichier
    // (voir QUOTE_DOCUMENT_TYPES et QUOTE_DOCUMENT_MAX_BYTES dans shared/pricing.ts).
    match /cabinets/{cabinetId}/dossiers/{dossierId}/devis/{fileName} {
      allow read: if inActiveCabinet(cabinetId);
      allow create: if inActiveCabinet(cabinetId)
        && resource == null
        && fileName.matches('^[A-Za-z0-9_-][A-Za-z0-9._-]{0,199}$')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
    }

    // Documents des dossiers (E12 : carte grise, permis, relevé d'information, autre) : PDF, JPG ou PNG de 10 Mo maximum,
    // nom de fichier simple, ni remplacés ni supprimés depuis l'app. L'entrée `documents/{id}` est écrite par
    // documents-enregistrer, qui relit le fichier (voir DOSSIER_DOCUMENT_* dans shared/documents.ts).
    match /cabinets/{cabinetId}/dossiers/{dossierId}/documents/{fileName} {
      allow read: if inActiveCabinet(cabinetId);
      allow create: if inActiveCabinet(cabinetId)
        && resource == null
        && fileName.matches('^[A-Za-z0-9_-][A-Za-z0-9._-]{0,199}$')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
    }

    // Tout autre emplacement est refusé : chaque nouveau dossier de fichiers reçoit sa propre règle.
  }
}
