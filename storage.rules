rules_version = '2';

// ⚠️ Même avertissement que firestore.rules : projet de test partagé, ne pas déployer seules.
service firebase.storage {
  match /b/{bucket}/o {
    // Membre d'un cabinet actif, depuis l'appareil de sa session en cours.
    function inActiveCabinet(cabinetId) {
      return request.auth != null
        && request.auth.token.ci_cabinet_id == cabinetId
        && firestore.get(/databases/(default)/documents/cabinets/$(cabinetId)).data.active == true
        && firestore.get(/databases/(default)/documents/cabinets/$(cabinetId)/members/$(request.auth.uid)).data.session.authTime
          == request.auth.token.auth_time;
    }

    // Logo du cabinet : lisible par ses membres, modifiable par ses admins (image ≤ 2 Mo).
    match /cabinets/{cabinetId}/logo/{fileName} {
      allow read: if inActiveCabinet(cabinetId);
      allow write: if inActiveCabinet(cabinetId)
        && request.auth.token.ci_role == 'admin'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Autres fichiers du cabinet (documents des dossiers, devis…).
    match /cabinets/{cabinetId}/{allPaths=**} {
      allow read, write: if inActiveCabinet(cabinetId);
    }
  }
}
