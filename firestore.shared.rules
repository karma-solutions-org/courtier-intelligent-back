rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isConnected() {
        return request.auth != null;
    }

    function isSameUid(docRef) {
        return isConnected() && (request.auth.uid == resource.data.userUid || request.auth.uid == docRef);
    }

    function isSameCreateUid() {
        return isConnected() && request.auth.uid == request.resource.data.userUid;
    }

    function isAdmin(){
        return isConnected() && (
          request.auth.token.admin == true ||
          request.auth.token.role == 'SUPER_ADMIN' ||
          request.auth.token.role == 'MULTI_ROLES'
        );
    }

    function isController(){
        return isConnected() && request.auth.token.controller == true;
    }

    function isGestionnaire(){
        return isConnected() && request.auth.token.gestionnaire == true;
    }

    function isPartenaire(){
        return isConnected() && request.auth.token.partenaire == true;
    }

    function isAgent(){
        return isConnected() && request.auth.token.agent == true;
    }

    function isCollecteur(){
        return isConnected() && request.auth.token.collecteur == true;
    }

    function isCompliScanTenant(data) {
        return isConnected() && (
            isAdmin() ||
            data.admin_id == null ||
            request.auth.uid == data.admin_id ||
            request.auth.token.admin_id == data.admin_id
        );
    }

    match /Profiles/{docRef} {
        allow read: if isConnected();
        allow create, update: if isSameCreateUid();
        allow update: if isAdmin();
    }

    match /Gestionnaires/{docRef} {
        allow get: if isSameUid(docRef) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isSameCreateUid();
    }

    match /Ribs/{docRef} {
        allow get: if isSameUid(docRef) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isSameCreateUid();
    }

    match /Reclamations/{docRef} {
        allow read: if isSameUid(docRef) || isAdmin();
        allow create: if isSameCreateUid();
        allow update: if isAdmin();
    }

    match /Devis/{docRef} {
        allow read: if isSameUid(docRef) || isAdmin();
        allow create: if isSameCreateUid();
        allow update: if isSameCreateUid() || isAdmin();
    }

    match /Encaissement/{docRef} {
        allow read: if isSameUid(docRef) || isAdmin();
        allow create: if isSameCreateUid();
        allow update: if isAdmin();
    }

    match /SoldeStats/{docRef} {
        allow read: if isSameUid(docRef) || isAdmin();
    }

    match /Notifications/{docRef} {
        allow read: if isSameUid(docRef) || isAdmin();
        allow update: if isSameCreateUid() || isAdmin();
    }

    match /Notes/{docRef} {
        allow read, create, update: if isAdmin();
    }

    match /User/{docRef} {
        allow read, update: if isAdmin();
    }

    match /Motif/{docRef} {
        allow read, update: if isAdmin();
        allow create: if true;
    }

    match /ExcelFile/{docRef} {
        allow read, write: if isAdmin();
    }

    match /XmlMandatSepa/{docRef} {
        allow create: if isAdmin();
        allow read: if isAdmin();
    }

    match /MandatSepaSubscribe/{docRef} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /MandatSepaTemp/{docRef} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
    }

    match /MandatSepaContractRenewal/{docRef} {
        allow create: if true;
        allow read, update, delete: if isAdmin() || isController() || isGestionnaire();
    }

    match /SepaXmlBankFileModel/{docRef} {
        allow read, write: if isAdmin();
    }

    match /SharedConfig/{docRef} {
        allow read: if true;
    }

    match /Tasks/{docRef} {
        allow read, write, update, delete: if true;
    }

    match /Tickets/{docRef} {
        allow read, write, update, delete: if true;
    }

    // ── bazz-work read model + interaction overlay (TEST phase — open).
    match /controleTickets/{docRef} {
        allow read: if true;
    }
    match /controlePayment/{docRef} {
        allow read: if true;
    }
    match /controleEtude/{docRef} {
        allow read: if true;
    }
    match /WorkManagers/{docRef} {
        allow read: if true;
    }
    match /WorkAssignments/{docRef} {
        allow read, write: if true;
    }
    match /WorkSettings/{docRef} {
        allow read, write: if true;
    }

    // ── bazzback* collections — dedicated to bazz-work (TEST phase — open).
    match /bazzbackTickets/{docRef} {
        allow read: if true;
    }
    match /bazzbackManagers/{docRef} {
        allow read: if true;
    }
    match /bazzbackPayments/{docRef} {
        allow read: if true;
    }
    match /bazzbackEtudes/{docRef} {
        allow read: if true;
    }
    match /bazzbackAssignments/{docRef} {
        allow read, write: if true;
    }
    match /bazzbackSettings/{docRef} {
        allow read, write: if true;
    }

    match /Candidates/{docId} {
        allow read, write: if request.auth != null;
    }
    match /Product/{id} {
        allow read, write: if request.auth != null;
    }

    match /recruitmentlog/{userId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    match /ControleProfiles/{docRef} {
        allow get: if isSameUid(docRef) || isAdmin();
        allow list: if isAdmin() || isController();
        allow create, update, delete: if isSameCreateUid() || isAdmin() || isController() ;
    }

    match /Compagnies/{docRef} {
        allow read, write: if isAdmin();
        allow read: if isController();
    }

    match /DevisControle/{docRef}{
        allow get: if isSameUid(docRef) || isAdmin() ;
        allow read, write: if isAdmin();
        allow create, update:if isAdmin();
    }

    match /Cabinet/{docRef}{
        allow get: if isSameUid(docRef) || isAdmin() || isCollecteur();
        allow read, write: if isAdmin()  || isCollecteur();
        allow create, update:if isAdmin();
    }

    match /accountsAibsCash/{docRef} {
        allow get, read, create, delete, update, write, list: if isAdmin();
        allow get, read, write: if isAgent() ||  isCollecteur();
    }

    match /paymentsAibsCash/{docRef} {
        allow get, read, write : if isAgent() || isAdmin();
    }

    match /facturesAibsCash/{docRef} {
        allow get, read, write : if isAgent() || isAdmin();
        allow delete : if isAdmin();
    }

    match /enveloppesAibsCash/{docRef} {
        allow get, read, write: if isAgent() ||  isCollecteur() || isAdmin();
    }

    match /ControleUsers/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /WinHistory/{document=**} {
        allow read: if request.auth != null;
    }

    match /TeamRewards/{document=**} {
        allow read: if request.auth != null;
    }

    match /UserPalierHistory/{docRef} {
        allow read, write: if isAdmin();
    }

    match /UserPalierHistory/{document=**} {
        allow read: if request.auth != null;
    }

    match /RhEvaluations/{docRef} {
        allow read, write: if isAdmin();
    }

    match /RhEvaluations/{document=**} {
        allow read: if request.auth != null;
    }

    match /paymentAibsCashHistory/{docId} {
        allow get, read, write : if  isAdmin();
    }

    match /factureAibsCashHistory/{docId} {
        allow get, read, write : if isAdmin();
    }

    match /transactionsAibsCash/{docRef} {
        allow get, read, write : if isAdmin();
    }

    match /historiqueAibsCash/{docRef} {
        allow get, read, write : if isCollecteur() || isAdmin();
    }

    match /AuditAppels/{docId} {
        allow read, write: if request.auth != null;
    }

    match /reclamation/{id} {
        allow read, write: if true;
    }

    match /rendez-vous/{rdvId} {
      allow read: if true;
      allow write: if true;
    }

    match /disponibilite/{dispoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ocrDocuments/{uid}/{filename} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ════════════════════════════════════════════════════════════════════
    // CompliScan Collections
    // ════════════════════════════════════════════════════════════════════

    match /UsersCompliScan/{docId} {
      allow read: if isConnected() && (
        request.auth.uid == docId ||
        request.auth.token.admin_id == resource.data.admin_id ||
        request.auth.uid == resource.data.admin_id ||
        isAdmin()
      );
      allow create, update: if isConnected() && (
        request.auth.uid == docId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /MailCompliScan/{docId} {
      allow read, write: if isConnected();
    }

    match /Clients/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /Scans/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /Alerts/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /Operations/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /Verifications/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /ComplianceDossiers/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /ComplianceSubflowInstances/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if isConnected() && isCompliScanTenant(resource.data);
    }

    match /ComplianceAuditLog/{docId} {
      allow read: if isConnected() && (resource == null || isCompliScanTenant(resource.data));
      allow create: if isConnected() && isCompliScanTenant(request.resource.data);
      allow update, delete: if false;
    }


      // ════════════════════════════════════════════════════════════════════
    // SG PBX & Other Systems
    // ════════════════════════════════════════════════════════════════════

    // Agent Asterisk (SG PBX) — DISTINCT de isAgent() ci-dessus (AIBS Partenaire,
    // collecte cash, sans rapport ; claim différent : pbxAgent, pas agent).
    function isPbxAgent() {
        return isConnected() && request.auth.token.pbxAgent == true;
    }

    // Interdit à l'agent de modifier autre chose que les champs listés, même
    // s'il a la permission "update" sur le document.
    function onlyChangedKeys(allowedKeys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    match /platformAdmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if request.auth != null &&
        (request.auth.uid == uid ||
         resource.data.companyId == request.auth.token.companyId);
      allow list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow write: if false;
    }

    match /companies/{docRef} {
      allow get, list: if request.auth != null &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
      allow get: if request.auth != null && request.auth.token.companyId == docRef;
      allow get, list: if isPbxAgent();
      allow update: if isPbxAgent() &&
                onlyChangedKeys(['provisioning', 'provisioningErrorText']);
      allow write: if false;
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) &&
        onlyChangedKeys(['provisioning', 'lastUpdatedAt']) &&
        resource.data.provisioning == 'failed' &&
        request.resource.data.provisioning == 'pending';
    }

    match /departments/{docRef} {
      allow get: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');
      allow update, delete: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');
    }
    match /teams/{docRef} {
      allow get: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');
      allow update, delete: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');
    }

       match /extensions/{docRef} {
      allow get, list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;

      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');

      // Édition inline, régénération du mot de passe SIP, désactivation et
      // marquage pending_deletion passent TOUS par un update côté front.
      // provisioningStatus limité à 'pending'/'pending_deletion' : seul
      // l'agent peut écrire 'applied'/'failed'.
      allow update: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN') &&
        onlyChangedKeys([
          'displayName', 'callerName', 'status',
          'musicOnHoldClass', 'ringTimeoutSeconds',
          'sipPassword', 'provisioningStatus',
          'updatedBy', 'lastUpdatedAt'
        ]) &&
        request.resource.data.provisioningStatus in ['pending', 'pending_deletion'];

      // Suppression réelle : uniquement l'agent, après nettoyage PJSIP.
      allow delete: if isPbxAgent();

      // Agent Asterisk — lecture globale (son jeton n'a pas de companyId),
      // écriture limitée à 2 champs.
      allow get, list: if isPbxAgent();
      allow update: if isPbxAgent() &&
        onlyChangedKeys(['provisioningStatus', 'provisioningErrorText']);
    }



       match /voicemail-boxes/{docRef} {
      allow get, list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');
      allow update: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN') &&
        onlyChangedKeys(['enabled', 'notifyEmail', 'provisioningStatus', 'updatedBy', 'lastUpdatedAt']) &&
        request.resource.data.provisioningStatus in ['pending', 'pending_deletion'];

      // Suppression réelle : uniquement l'agent, après avoir retiré le fichier .conf.
      allow delete: if isPbxAgent();

      // Agent Asterisk — resolveVoicemailOwner/regenerateCompanyDialplan lisent
      // cette collection, et l'agent marque applied/failed/suspended.
      allow get, list: if isPbxAgent();
      allow update: if isPbxAgent() &&
        onlyChangedKeys(['provisioningStatus', 'provisioningErrorText']);
    }
    match /call-logs/{docRef} {
      allow get: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;
      allow create, update: if isPbxAgent();
      allow delete: if false;
    }

        match /ring-groups/{docRef} {
      allow get, list: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId;

      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN');

      // Le front ne peut poser provisioningStatus que sur 'pending'/'pending_deletion' —
      // 'applied'/'failed'/'suspended'/'deletion_failed' sont réservés à l'agent.
      allow update: if request.auth != null &&
        resource.data.companyId == request.auth.token.companyId &&
        (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN') &&
        onlyChangedKeys([
          'name', 'memberUserIds', 'strategy', 'ringTimeoutSeconds',
          'musicOnHoldClass', 'fallback', 'provisioningStatus',
          'updatedBy', 'lastUpdatedAt'
        ]) &&
        request.resource.data.provisioningStatus in ['pending', 'pending_deletion'];

      // Suppression réelle : uniquement l'agent, après avoir retiré la ligne de dialplan.
      allow delete: if isPbxAgent();

      // Agent Asterisk — lecture globale (son jeton n'a pas de companyId),
      // écriture limitée à 2 champs.
      allow get, list: if isPbxAgent();
      allow update: if isPbxAgent() &&
        onlyChangedKeys(['provisioningStatus', 'provisioningErrorText']);
    }

        match /voicemail-messages/{docId} {
        allow get, list: if request.auth != null &&
          resource.data.companyId == request.auth.token.companyId &&
          (
            (resource.data.ownerType == 'user' && resource.data.ownerId == request.auth.uid) ||
            (resource.data.ownerType == 'ringGroup' && (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN'))
          );
        allow update: if request.auth != null &&
          resource.data.companyId == request.auth.token.companyId &&
          (
            (resource.data.ownerType == 'user' && resource.data.ownerId == request.auth.uid) ||
            (resource.data.ownerType == 'ringGroup' && (request.auth.token.role == 'COMPANY_OWNER' || request.auth.token.role == 'COMPANY_ADMIN'))
          ) &&
          onlyChangedKeys(['read']);
        allow create: if isPbxAgent();
        allow delete: if false;
      }

    // ⚠️ MODIFIE : le catch-all n'accorde plus rien aux collections freelance*,
    // afin que leurs regles dediees (plus bas) soient reellement appliquees.
    // Il n'accorde rien non plus aux collections ci_ (Courtier Intelligent) : seules leurs regles dediees s'appliquent.
    // Comportement inchange pour TOUTES les autres collections.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !collection.matches('freelance.*')
        && !collection.matches('ci_.*');
    }

    match /UsersPaie/{docRef} {
        allow get: if isSameUid(docRef) || isAdmin();
        allow list: if isAdmin();
        allow create, update, delete: if isSameCreateUid() || isAdmin();
    }

       match /platform-health/{machineId} {
      allow get, list: if request.auth != null &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
      allow create, update: if isPbxAgent();
      allow delete: if false;
    }

    match /company-inventory/{companyId} {
      allow get, list: if request.auth != null &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
      allow create, update: if isPbxAgent();
      allow delete: if false;
    }

      match /platform-health-history/{machineId} {
    allow get, list: if request.auth != null &&
      exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    allow create, update: if isPbxAgent();
    allow delete: if false;
  }

    match /cleanup-requests/{docRef} {
      allow get, list: if request.auth != null &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));


      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.kind in ['ivrAnnouncement', 'musicTrack'] &&
        request.resource.data.name is string &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.createdBy == request.auth.uid;


      allow update: if request.auth != null &&
        request.auth.token.pbxAgent == true &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'errorText', 'deletedBytes', 'lastUpdatedAt']);

      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════
    // Freelance Platform (Solution Groupe)
    // Les ecritures metier passent par les Cloud Functions (Admin SDK, qui
    // contourne les Rules) : la plupart des collections sont en write: if false.
    // ════════════════════════════════════════════════════════════════════

    function freelanceIsSignedIn() {
      return request.auth != null;
    }

    function freelanceRole() {
      return freelanceIsSignedIn() ? request.auth.token.role : null;
    }

    function freelanceIsAdmin() {
      return freelanceRole() == 'admin';
    }

    function freelanceIsFreelance() {
      return freelanceRole() == 'freelance';
    }

    function freelanceChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Champs du profil pilotes par le serveur ou l'admin : jamais ecrits par le developpeur.
    function freelanceProfileServerKeys() {
      return ['role', 'createdAt', 'developerStatus', 'statusHistory', 'verificationStatus',
              'verificationComment', 'verificationUpdatedAt', 'verificationUpdatedBy'];
    }

    // Seuls champs qu'un developpeur peut envoyer en deposant un projet.
    function freelanceMissionCreateKeys() {
      return ['title', 'description', 'githubUrl', 'clientName', 'clientEmail', 'amount',
              'currency', 'depositAmount', 'finalPaymentBeforeDelivery', 'freelanceId', 'status',
              'correctionCyclesUsed', 'cgvAcceptedAt', 'cgvVersion', 'createdAt'];
    }

    match /freelanceProfiles/{userId} {
      allow read: if freelanceIsSignedIn() && (request.auth.uid == userId || freelanceIsAdmin());
      allow create: if freelanceIsAdmin()
        || (freelanceIsSignedIn() && request.auth.uid == userId
            && !request.resource.data.keys().hasAny(freelanceProfileServerKeys()));
      allow update: if freelanceIsAdmin()
        || (freelanceIsSignedIn() && request.auth.uid == userId
            && !freelanceChangedKeys().hasAny(freelanceProfileServerKeys()));
      allow delete: if freelanceIsAdmin();
    }

            match /freelanceMissions/{missionId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.freelanceId == request.auth.uid);
      allow create: if freelanceIsFreelance()
        && request.resource.data.freelanceId == request.auth.uid
        && get(/databases/$(database)/documents/freelanceProfiles/$(request.auth.uid)).data.verificationStatus == 'valide'
        && request.resource.data.keys().hasOnly(freelanceMissionCreateKeys())
        && request.resource.data.status == 'deposee'
        && request.resource.data.correctionCyclesUsed == 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency in ['EUR', 'USD', 'TND']
        && request.resource.data.githubUrl is string
        && request.resource.data.githubUrl.matches('https?://.+');
      allow update: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.freelanceId == request.auth.uid
            && freelanceChangedKeys().hasOnly(['status', 'deliveredAt', 'recetteStartedAt'])
            && resource.data.status in ['deposee', 'en_developpement']
            && request.resource.data.status == 'en_recette');
      allow delete: if freelanceIsAdmin();
    }

    match /freelanceMissionAccess/{missionId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }
         match /freelanceMissionAccess/{missionId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }
    match /freelanceAcceptanceReviews/{reviewId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceInvoices/{invoiceId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.freelanceId == request.auth.uid);
      allow write: if false;
    }

    match /freelanceDeveloperInvoices/{missionId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.developerId == request.auth.uid);
      allow write: if false;
    }

    match /freelanceMissionPricing/{missionId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceCounters/{counterId} {
      allow read, write: if false;
    }

    match /freelanceEscrowLedger/{entryId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelancePayoutBatches/{batchId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceFeeConfigurations/{configId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceAuditLogs/{logId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.missionId != null
            && get(/databases/$(database)/documents/freelanceMissions/$(resource.data.missionId)).data.freelanceId == request.auth.uid);
      allow write: if false;
    }

    match /freelanceCreditNotes/{noteId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceServiceContracts/{contractId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceDeveloperStatusChanges/{changeId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.developerId == request.auth.uid);
      allow write: if false;
    }

    match /freelanceFiscalCategories/{categoryId} {
      allow read: if freelanceIsAdmin();
      allow write: if false;
    }

    match /freelanceDocumentRequirements/{requirementId} {
      allow read: if freelanceIsSignedIn();
      allow write: if false;
    }

    match /freelanceDeveloperDocuments/{documentId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && resource.data.developerId == request.auth.uid);
      allow write: if false;
    }


    match /freelanceIpTransfers/{missionId} {
      allow read: if freelanceIsAdmin()
        || (freelanceIsFreelance() && (resource == null || resource.data.developerId == request.auth.uid));
      allow write: if false;
    }
      match /profilNexus/{profilId} {
      allow get: if true;
    }

    match /serviceNexus/{serviceId}     { allow read: if true; }
    match /produitNexus/{produitId}     { allow read: if true; }
    match /portfolioNexus/{portfolioId} { allow read: if true; }
    match /avisNexus/{avisId}           { allow read: if true; }

    // ═══ À COLLER dans match /databases/{database}/documents, AVANT le catch-all ═══
    // ════════════════════════════════════════════════════════════════════
    // Courtier Intelligent (cabinets de courtage)
    //
    // Claims posés UNIQUEMENT par les Cloud Functions :
    //   ci_cabinet_id : cabinet de l'utilisateur
    //   ci_role       : 'admin' | 'courtier'
    // Préfixe "ci_" : à ne pas confondre avec token.role / token.admin des autres
    // applications qui partagent cette base.
    //
    // Un seul appareil par utilisateur : seul le token dont auth_time égale
    // cabinets/{t}/members/{uid}.session.authTime a accès aux données
    // (posé par la function sessions-ouvrir).
    //
    // Ecritures serveur uniquement (Functions / Admin SDK) : création du cabinet,
    // offre et limites (planId, overrides, limits), membres (rôle, statut, appareil), invitations,
    // journal d'audit, compteurs, catalogue.
    // ════════════════════════════════════════════════════════════════════

    function ciCabinetId() {
      return isConnected() ? request.auth.token.get('ci_cabinet_id', null) : null;
    }

    function ciRole() {
      return isConnected() ? request.auth.token.get('ci_role', null) : null;
    }

    // Membre du cabinet t (claims uniquement, sans contrôle de session).
    function ciIsMember(t) {
      return ciCabinetId() != null && ciCabinetId() == t;
    }

    // Membre actif dont l'appareil courant détient la session.
    function ciSessionOk(t) {
      let member = get(/databases/$(database)/documents/ci_cabinets/$(t)/ci_members/$(request.auth.uid)).data;
      return member.get('status', null) == 'active'
        && member.get('session', null) != null
        && member.session.get('authTime', null) == request.auth.token.auth_time;
    }

    // Cabinet au-delà de sa limite d'utilisateurs (baisse d'offre) : une fois le délai de grâce
    // (cabinets/{t}.graceEndsAt) écoulé, seuls les admins gardent l'accès.
    function ciWithinSeatLimit(t) {
      let cabinet = get(/databases/$(database)/documents/ci_cabinets/$(t)).data;
      return cabinet.get('graceEndsAt', null) == null
        || request.time < cabinet.graceEndsAt
        || ciRole() == 'admin';
    }

    // Cabinet actif : un cabinet désactivé (script set-cabinet-status) n'a plus aucun accès.
    function ciCabinetActive(t) {
      return get(/databases/$(database)/documents/ci_cabinets/$(t)).data.get('active', false) == true;
    }

    // Membre du cabinet t, actif, sur son appareil de session.
    function ciActive(t) {
      return ciIsMember(t) && ciCabinetActive(t) && ciSessionOk(t) && ciWithinSeatLimit(t);
    }

    function ciActiveAdmin(t) {
      return ciActive(t) && ciRole() == 'admin';
    }

    // Même contrôle pour les ressources globales (catalogue, mémoire des formulaires).
    function ciActiveAnyCabinet() {
      return ciCabinetId() != null && ciCabinetActive(ciCabinetId()) && ciSessionOk(ciCabinetId());
    }

    // Les champs listés ne doivent pas changer (update uniquement).
    function ciKeysUnchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }


    // ── Extension Chrome ────────────────────────────────────────────────────
    // L'extension se connecte avec le compte de l'app, mais son jeton a SA propre heure de connexion (auth_time),
    // enregistrée dans la session de l'app par la function sessions-ouvrirExtension. Elle n'a donc jamais les droits
    // de l'app, et perd les siens dès que la session de l'app disparaît (fermée, remplacée, appareil réinitialisé,
    // membre désactivé, cabinet désactivé).
    function ciExtActive(t) {
      let member = get(/databases/$(database)/documents/ci_cabinets/$(t)/ci_members/$(request.auth.uid)).data;
      let cabinet = get(/databases/$(database)/documents/ci_cabinets/$(t)).data;
      return request.auth != null
        && request.auth.token.get('ci_cabinet_id', null) == t
        && cabinet.get('active', false) == true
        && (cabinet.get('graceEndsAt', null) == null
            || request.time < cabinet.graceEndsAt
            || request.auth.token.get('ci_role', null) == 'admin')
        && member.get('status', null) == 'active'
        && member.get('session', null) != null
        && member.session.get('extensionAuthTime', null) == request.auth.token.auth_time;
    }

    function ciExtAny() {
      return request.auth != null
        && request.auth.token.get('ci_cabinet_id', null) != null
        && ciExtActive(request.auth.token.ci_cabinet_id);
    }

    // Jobs de tarification de l'extension : seul le statut et la progression sont modifiables.
    // Offre capturée par l'extension (E10) : au moins une prime, types et tailles contrôlés
    // (le contenu des listes est normalisé par les functions).
    function ciExtOfferValid(offer) {
      return (offer.premiumAnnual is number || offer.premiumMonthly is number)
        && (offer.premiumAnnual == null || (offer.premiumAnnual is number && offer.premiumAnnual >= 0))
        && (offer.premiumMonthly == null || (offer.premiumMonthly is number && offer.premiumMonthly >= 0))
        && (offer.quoteNumber == null || (offer.quoteNumber is string && offer.quoteNumber.size() <= 60))
        && offer.deductibles is map && offer.deductibles.size() <= 20
        && offer.guarantees is list && offer.guarantees.size() <= 60
        && offer.exclusions is list && offer.exclusions.size() <= 30
        && offer.capturedAt == request.time;
    }

    // Statuts où l'extension travaille sur un job (RUNNABLE_STATUSES, extension/src/background/origin-match.ts).
    function ciExtRunnableStatuses() {
      return ['requested', 'analyzing', 'needs_info', 'filling', 'awaiting_submit'];
    }

    // Transitions écrites par l'extension (engine/runner.ts, background/service-worker.ts, jobs-service.ts) :
    // 'analyzing' au démarrage, puis 'needs_info' / 'filling' / 'awaiting_submit' (l'échec du rapport 'analyzing'
    // n'arrête pas le remplissage, d'où depuis 'requested'), 'captured' (writeCapturedOffer, possible dès l'ouverture
    // d'une page de résultat) et 'failed' (rejectCapture). 'captured' et 'failed' sont terminaux pour l'extension :
    // seule la function tarification-lancer relance un job (Admin SDK).
    function ciExtJobTransitions() {
      return {
        'requested':       ['analyzing', 'needs_info', 'filling', 'awaiting_submit', 'captured', 'failed'],
        'analyzing':       ['analyzing', 'needs_info', 'filling', 'awaiting_submit', 'captured', 'failed'],
        'needs_info':      ['analyzing', 'needs_info', 'filling', 'awaiting_submit', 'captured', 'failed'],
        'filling':         ['analyzing', 'needs_info', 'filling', 'awaiting_submit', 'captured', 'failed'],
        'awaiting_submit': ['analyzing', 'needs_info', 'filling', 'awaiting_submit', 'captured', 'failed']
      };
    }

    function ciExtJobUpdate() {
      let next = request.resource.data;
      return next.ownerUid == resource.data.ownerUid
        && next.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'currentStep', 'totalSteps', 'error', 'attempts', 'missingFields', 'updatedAt'])
        && resource.data.get('status', null) in ciExtRunnableStatuses()
        && next.status in ciExtJobTransitions()[resource.data.status]
        && (next.get('missingFields', null) == null
            || (next.missingFields is list && next.missingFields.size() <= 200))
        && (next.get('error', null) == null
            || (next.error is string && next.error.size() <= 2000));
    }

    // Offre écrite par l'extension : get() lit le job AVANT le batch writeCapturedOffer (offre + job 'captured'),
    // il est donc encore dans un statut de travail (une page de résultat peut être capturée dès 'requested').
    function ciExtOfferWrite(t, dossierId, insurerId) {
      let job = get(/databases/$(database)/documents/ci_cabinets/$(t)/ci_dossiers/$(dossierId)/ci_quoteJobs/$(insurerId)).data;
      return ciExtActive(t)
        && job.ownerUid == request.auth.uid
        && job.get('status', null) in ciExtRunnableStatuses()
        && request.resource.data.source == 'auto'
        && request.resource.data.keys().hasOnly(['quoteNumber', 'premiumAnnual', 'premiumMonthly', 'deductibles',
                                                 'guarantees', 'exclusions', 'source', 'capturedAt', 'review'])
        // Sans confirmation dans l'extension : le tarif lu arrive « à vérifier » dans l'onglet Tarification.
        && request.resource.data.get('review', 'pending') == 'pending'
        && ciExtOfferValid(request.resource.data);
    }

    // Le courtier valide dans l'app un tarif lu par l'extension (à vérifier) : seuls l'état de vérification, son
    // auteur et sa date changent. Une correction passe par la saisie manuelle (function tarification-saisirOffre).
    function ciOfferReviewValid() {
      let next = request.resource.data;
      return resource.data.get('source', null) == 'auto'
        && resource.data.get('review', null) == 'pending'
        && next.diff(resource.data).affectedKeys().hasOnly(['review', 'reviewedBy', 'reviewedAt'])
        && next.review == 'validated'
        && next.reviewedBy == request.auth.uid
        && next.reviewedAt == request.time;
    }

    // La requête du side panel : « mes jobs en cours », tous dossiers confondus.
    match /{path=**}/ci_quoteJobs/{insurerId} {
      allow read: if ciExtAny() && resource.data.ownerUid == request.auth.uid;
    }

    match /ci_cabinets/{cabinetId} {
      allow read: if ciActive(cabinetId);
      // Création, planId, overrides, limits, graceEndsAt, deviceResets, ownerUid, active : serveur uniquement.
      allow create, delete: if false;
      allow update: if ciActiveAdmin(cabinetId) &&
        onlyChangedKeys(['name', 'orias', 'address', 'phone', 'email', 'logoPath',
                         'enabledInsurers', 'enabledProducts']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200;

      match /ci_members/{uid} {
        // L'extension relit sa propre fiche pour savoir si sa session est toujours ouverte.
        allow get: if request.auth.uid == uid && ciExtActive(cabinetId);
        // Son propre document reste lisible même sans la session : l'app y détecte
        // qu'un autre appareil a pris la main.
        allow get: if (ciIsMember(cabinetId) && request.auth.uid == uid) || ciActive(cabinetId);
        allow list: if ciActive(cabinetId);
        // Seul le signal de vie (session.lastSeen) sur son propre document ;
        // rôle, statut et session.authTime sont posés par les Functions.
        allow update: if ciActive(cabinetId) &&
          request.auth.uid == uid &&
          resource.data.get('session', null) != null &&
          onlyChangedKeys(['session']) &&
          request.resource.data.session.diff(resource.data.session).affectedKeys().hasOnly(['lastSeen']) &&
          request.resource.data.session.lastSeen == request.time;
        allow create, delete: if false;
      }

      // Invitations : lecture par l'admin, écriture par les Functions.
      match /ci_invitations/{invitationId} {
        allow read: if ciActiveAdmin(cabinetId);
        allow write: if false;
      }

      // Journal des connexions et des appareils : lu par les admins, écrit par les Functions.
      match /ci_auditLog/{entryId} {
        allow read: if ciActiveAdmin(cabinetId);
        allow write: if false;
      }

      match /ci_counters/{counterId} {
        allow read, write: if false;
      }

      match /ci_assures/{assureId} {
        allow read: if ciActive(cabinetId);
        // Champs écrits par AssuresService.create (toAssureData + createdBy + createdAt), mêmes limites qu'à l'update.
        allow create: if ciActive(cabinetId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.keys().hasOnly(['type', 'civilite', 'firstName', 'lastName', 'companyName', 'siret',
            'birthDate', 'email', 'phone', 'address', 'createdBy', 'createdAt']) &&
          (request.resource.data.get('address', null) == null ||
            (request.resource.data.address is map && request.resource.data.address.size() <= 10)) &&
          request.resource.data.get('firstName', '') is string &&
          request.resource.data.get('firstName', '').size() <= 200 &&
          request.resource.data.get('lastName', '') is string &&
          request.resource.data.get('lastName', '').size() <= 200;
        // Champs écrits par AssuresService.update (toAssureData + updatedAt).
        allow update: if ciActive(cabinetId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'civilite', 'firstName',
            'lastName', 'companyName', 'siret', 'birthDate', 'email', 'phone', 'address', 'updatedAt']) &&
          (request.resource.data.get('address', null) == null ||
            (request.resource.data.address is map && request.resource.data.address.size() <= 10)) &&
          request.resource.data.get('firstName', '') is string &&
          request.resource.data.get('firstName', '').size() <= 200 &&
          request.resource.data.get('lastName', '') is string &&
          request.resource.data.get('lastName', '').size() <= 200;
        allow delete: if ciActiveAdmin(cabinetId);

        // Pièces du client (CNI, Kbis) : rattachées par la function assures-rattacherPiece.
        match /ci_documents/{documentId} {
          allow read: if ciActive(cabinetId);
          allow write: if false;
        }
      }

      match /ci_dossiers/{dossierId} {
        allow read: if ciActive(cabinetId);
        // Création, données, besoin, statut, assignation et référence passent par les functions dossiers-* :
        // elles appliquent la machine à états, la complétude et la numérotation.
        allow create: if false;
        // Liste blanche (vide) : l'app n'écrit aucun champ du dossier directement — tout passe par les functions
        // dossiers-*, tarification-*, propositions-*, documents-* (Admin SDK). decision, proposal, outcome… : serveur.
        allow update: if ciActive(cabinetId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
        // Un dossier ne se supprime pas : on le passe en « sans_suite ».
        allow delete: if false;

        // Tarification : l'app écrit « requested », l'extension (même identité)
        // écrit le statut, la progression et les informations manquantes.
        // Jobs et offres : écrits par les functions tarification-* (besoin validé, assureur activé, offre contrôlée)
        // et par l'extension (voir plus bas), jamais directement par l'app.
        match /ci_quoteJobs/{insurerId} {
          allow read: if ciActive(cabinetId);
        }

        match /ci_offers/{insurerId} {
          allow read: if ciActive(cabinetId);
          // Seule exception écrite par l'app : la validation d'un tarif lu par l'extension (voir ciOfferReviewValid).
          allow update: if ciActive(cabinetId) && ciOfferReviewValid();
        }

        match /ci_documents/{documentId} {
          allow read: if ciActive(cabinetId);
          // Écrits uniquement par les functions documents-enregistrer / documents-analyser (statut, OCR, chemin).
          allow create, update: if false;
          allow delete: if ciActiveAdmin(cabinetId) ||
            (ciActive(cabinetId) && resource.data.get('uploadedBy', null) == request.auth.uid);
        }

        // ── Extension : jobs et offres (voir ciExtActive). Écriture limitée au statut du job et aux offres automatiques.
        match /ci_quoteJobs/{insurerId} {
          allow get, list: if ciExtActive(cabinetId) && resource.data.ownerUid == request.auth.uid;
          allow update: if ciExtActive(cabinetId) && resource.data.ownerUid == request.auth.uid && ciExtJobUpdate();
        }

        match /ci_offers/{insurerId} {
          allow create: if ciExtOfferWrite(cabinetId, dossierId, insurerId);
          // Jamais par-dessus une offre saisie à la main dans l'app.
          allow update: if resource.data.get('source', null) == 'auto'
            && ciExtOfferWrite(cabinetId, dossierId, insurerId);
        }

        // Historique non modifiable : création seule.
        match /ci_events/{eventId} {
          allow read: if ciActive(cabinetId);
          // Les événements du dossier sont écrits par les functions ; seule une note est ajoutée depuis l'app.
          allow create: if ciActive(cabinetId) &&
            request.resource.data.keys().hasOnly(['type', 'by', 'at', 'data']) &&
            request.resource.data.type == 'note' &&
            request.resource.data.by == request.auth.uid &&
            request.resource.data.at == request.time &&
            (request.resource.data.get('data', null) == null ||
              (request.resource.data.data is map && request.resource.data.data.size() <= 5));
          allow update, delete: if false;
        }
      }
    }

    // ── Catalogue global : lecture pour les utilisateurs d'un cabinet, écriture serveur.
    match /ci_products/{productId} {
      allow read: if ciActiveAnyCabinet() || ciExtAny();
      allow write: if false;
    }

    match /ci_insurers/{insurerId} {
      allow read: if ciActiveAnyCabinet() || ciExtAny();
      allow write: if false;
    }

    match /ci_plans/{planId} {
      allow read: if ciActiveAnyCabinet();
      allow write: if false;
    }

    match /ci_guaranteeSynonyms/{productId} {
      allow read: if ciActiveAnyCabinet() || ciExtAny();
      allow write: if false;
    }

    // ── Mémoire partagée des formulaires (structure seulement, AUCUNE donnée client).
    // Partagée entre tous les cabinets, lue par l'extension. Écrite UNIQUEMENT par les functions memoires-*,
    // qui valident à la lettre chaque champ (les règles ne peuvent pas contrôler le contenu d'une liste) :
    // un cabinet ne peut donc ni y déposer une valeur, ni fausser la mémoire des autres.
    match /ci_formMemories/{memoryKey} {
      allow read: if ciExtAny();
      allow write: if false;
    }

    // ── Signalements de l'extension (AUCUNE donnée client) : création seule.
    match /ci_extensionReports/{reportId} {
      // Codes fermés (voir EXTENSION_REPORT_ISSUES dans shared/models.ts) : un texte libre pourrait porter une donnée client.
      allow create: if ciExtAny()
        && request.resource.data.keys().hasOnly(['insurerId', 'origin', 'step', 'issue', 'at'])
        && request.resource.data.keys().hasAll(['insurerId', 'origin', 'step', 'issue', 'at'])
        && request.resource.data.insurerId is string
        && request.resource.data.insurerId.size() > 0
        && request.resource.data.insurerId.size() <= 100
        // L'origine seule (jamais le chemin ni les paramètres de l'URL), ou vide si elle est inconnue.
        && request.resource.data.origin is string
        && request.resource.data.origin.matches('^(https://[a-zA-Z0-9.:-]{1,200}|http://localhost(:[0-9]+)?)?$')
        && request.resource.data.step in ['detect', 'extract', 'confirm', 'write']
        && request.resource.data.issue in ['premium_not_found', 'ai_unavailable', 'ai_unusable', 'capture_rejected', 'offer_write_failed']
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }
  }
}
