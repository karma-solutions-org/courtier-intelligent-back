{
  "name": "courtier-intelligent-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run sync-shared && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore",
    "deploy": "firebase deploy --project aibs-partenaire-testing --only functions:courtier-intelligent",
    "logs": "firebase functions:log",
    "use-test": "firebase use test",
    "sync-shared": "node scripts/sync-shared.mjs",
    "list-vpc": "node -e \"\"",
    "test": "cd .. && npx --yes firebase-tools@15.32.1 emulators:exec --only firestore --project demo-courtier-intelligent \"node --test functions/test/firestore-rules.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:emulator": "node --test test/firestore-rules.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.19.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
