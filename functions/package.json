{
  "name": "courtier-intelligent-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run sync-shared && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore",
    "deploy": "firebase deploy --project aibs-partenaire-testing --only functions:courtier-intelligent",
    "logs": "firebase functions:log",
    "use-test": "firebase use test",
    "sync-shared": "node scripts/sync-shared.mjs",
    "test:rules": "cd .. && npx -y firebase-tools emulators:exec --only firestore --project demo-courtier-intelligent \"node --test functions/test/firestore-rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "firebase": "^12.19.0",
    "typescript": "^5.9.3"
  }
}
